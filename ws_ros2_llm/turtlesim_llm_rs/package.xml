  <version>0.0.0</version>
  <description>Simple connection of LLM (powered by MS Foundry Local) to turtlesim.</description>
  <maintainer email="micmazur@pg.edu.pl">Michał Mazur</maintainer>
  <license>LGPL-3.0-only</license>

  <buildtool_depend>ament_cargo</buildtool_depend>

  <depend>rclrs</depend>
  <depend>rosidl_runtime_rs</depend>
  <depend>turtlesim</depend>
  <depend>turtlesim_llm_msgs</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
